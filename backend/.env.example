# ==========================================
# SkillMate Environment Configuration
# ==========================================

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME=SkillMate
# Frontend URL for CORS (comma-separated if multiple, e.g. production Vercel URL and local dev)
FRONTEND_URL=https://skill-mate-seven.vercel.app

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skillmate_db?schema=public

# Authentication & JWT
JWT_SECRET=super-secret-jwt-access-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_ACCESS_SECRET=super-secret-jwt-access-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=super-secret-jwt-refresh-key-change-in-production
JWT_REFRESH_EXPIRATION=7d

# Throttling / Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Geographic Bounds (Mumbai Metropolitan Region - Centroid Defaults)
DEFAULT_SEARCH_RADIUS_KM=5
MAX_SEARCH_RADIUS_KM=25

# AI / Smart Query & Semantic Matching (Stage 7A-7D)
# Leave blank or unconfigured to automatically use built-in rule-based & deterministic fallbacks
GEMINI_API_KEY=your-gemini-api-key-here
AI_API_KEY=your-gemini-api-key-here
